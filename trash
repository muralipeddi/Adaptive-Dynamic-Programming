#!/usr/bin/env python3

import rclpy
from rclpy.node import Node
from nav_msgs.msg import Odometry
from ackermann_msgs.msg import AckermannDriveStamped
from std_msgs.msg import Float32MultiArray
from ament_index_python.packages import get_package_share_directory

import numpy as np
import os
from scipy.interpolate import RegularGridInterpolator

class ADPRacelineRunner(Node):
    def __init__(self):
        super().__init__('adp_raceline_runner')

        # Parameters
        self.declare_parameter('speed', 1.5)
        self.speed = self.get_parameter('speed').get_parameter_value().double_value

        # Load gain table
        utils_dir = os.path.join(
            get_package_share_directory('adp_controller'), 'scripts', 'utils')
        K_table = np.load(os.path.join(utils_dir, 'K_table.npy'))
        vx_grid = np.load(os.path.join(utils_dir, 'vx_grid.npy'))
        kappa_grid = np.load(os.path.join(utils_dir, 'kappa_grid.npy'))
        self.K_interp = RegularGridInterpolator(
            (vx_grid, kappa_grid), K_table[:, :, 0, :], bounds_error=False, fill_value=0.0)

        # State
        self.frenet_errors = None
        self.vx = 0.0
        self.kappa = 0.0

        # ROS Interfaces
        self.create_subscription(Float32MultiArray, '/frenet_errors', self.frenet_callback, 10)
        self.create_subscription(Odometry, '/ego_racecar/odom', self.odom_callback, 10)
        self.drive_pub = self.create_publisher(AckermannDriveStamped, '/drive', 10)
        self.timer = self.create_timer(0.02, self.control_loop)

        self.get_logger().info(f"ADP Raceline Runner Initialized at speed {self.speed:.2f} m/s")

    def frenet_callback(self, msg):
        self.frenet_errors = msg.data
        self.kappa = msg.data[4]  # extract curvature

    def odom_callback(self, msg):
        self.vx = msg.twist.twist.linear.x

    def control_loop(self):
        if self.frenet_errors is None:
            return

        e_y, dot_e_y, e_psi, dot_e_psi = self.frenet_errors[:4]
        x = np.array([e_y, dot_e_y, e_psi, dot_e_psi])

        vx_clip = np.clip(self.speed, 0.5, 15.0)
        kappa_clip = np.clip(self.kappa, -3.0, 3.0)
        try:
            K = self.K_interp((vx_clip, kappa_clip))
            K = np.clip(K, -20.0, 20.0)
        except:
            self.get_logger().warn("K interpolation failed, using zero gain")
            K = np.zeros(4)

        delta = float(-np.dot(K, x))
        delta = np.clip(delta, -0.4189, 0.4189)

        # Log gains and control
        self.get_logger().info(f"Vx: {vx_clip:.2f}, kappa: {kappa_clip:.2f}, K: {K}, x: {x}, delta: {delta:.3f}")

        msg = AckermannDriveStamped()
        msg.drive.steering_angle = delta
        msg.drive.speed = self.speed
        self.drive_pub.publish(msg)


def main(args=None):
    rclpy.init(args=args)
    node = ADPRacelineRunner()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    node.destroy_node()
    rclpy.shutdown()

if __name__ == '__main__':
    main()
