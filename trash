#!/usr/bin/env python3

import rclpy
from rclpy.node import Node
from std_msgs.msg import Float32

class RealCarConstantSpeed(Node):
    def __init__(self):
        super().__init__('real_car_constant_speed')

        # Publishers for VESC topics
        self.motor_pub = self.create_publisher(Float32, '/vesc/commands/motor', 10)
        self.servo_pub = self.create_publisher(Float32, '/vesc/commands/servo', 10)

        self.target_speed = 1.5  # m/s equivalent (depends on VESC config)
        self.target_steering = 0.0  # radians (center)

        self.create_timer(0.05, self.control_loop)
        self.get_logger().info("Publishing constant motor and steering commands...")

    def control_loop(self):
        motor_msg = Float32()
        motor_msg.data = self.target_speed
        self.motor_pub.publish(motor_msg)

        servo_msg = Float32()
        servo_msg.data = self.target_steering
        self.servo_pub.publish(servo_msg)

def main(args=None):
    rclpy.init(args=args)
    node = RealCarConstantSpeed()
    rclpy.spin(node)
    node.destroy_node()
    rclpy.shutdown()
