#!/usr/bin/env python3

import rclpy
from rclpy.node import Node
from ackermann_msgs.msg import AckermannDriveStamped

class ConstantSpeedController(Node):
    def __init__(self):
        super().__init__('constant_speed_controller')

        # Create publisher to /drive
        self.drive_pub = self.create_publisher(AckermannDriveStamped, '/drive', 10)

        # Set desired control parameters
        self.target_speed = 1.5  # m/s
        self.target_steering_angle = 0.0  # radians

        # Run control loop at 50 Hz
        self.create_timer(0.02, self.publish_drive_command)

        self.get_logger().info("Constant Speed Controller started.")

    def publish_drive_command(self):
        msg = AckermannDriveStamped()
        msg.drive.speed = self.target_speed
        msg.drive.steering_angle = self.target_steering_angle
        self.drive_pub.publish(msg)

def main(args=None):
    rclpy.init(args=args)
    node = ConstantSpeedController()
    rclpy.spin(node)
    node.destroy_node()
    rclpy.shutdown()
