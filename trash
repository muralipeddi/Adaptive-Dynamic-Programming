#!/usr/bin/env python3

import numpy as np
import matplotlib.pyplot as plt

# === Load raceline === #
raceline_path = "/home/can-02/Desktop/f1tenth_ws/src/adp_controller/waypoints/optimal_raceline.csv"
data = np.loadtxt(raceline_path, delimiter=",", skiprows=1)
x = data[:, 0]
y = data[:, 1]
kappa = data[:, 3]
N = len(x)

# === Sampling time from spline resolution and nominal speed === #
dt = 0.333  # seconds
T = N * dt
t_arr = np.arange(N) * dt

# === Compute Fourier Coefficients === #
def compute_fourier_coeffs(signal, T):
    N = len(signal)
    a0 = np.sum(signal) / N
    a = []
    b = []
    for n in range(1, N // 2):
        omega = 2 * np.pi * n / T
        cos_n = np.cos(omega * t_arr)
        sin_n = np.sin(omega * t_arr)
        a_n = 2 / N * np.dot(signal, cos_n)
        b_n = 2 / N * np.dot(signal, sin_n)
        a.append(a_n)
        b.append(b_n)
    return a0, np.array(a), np.array(b)

# === Reconstruct signal === #
def reconstruct(a0, a, b, T, t):
    result = np.ones_like(t) * a0
    for n in range(1, len(a) + 1):
        omega = 2 * np.pi * n / T
        result += a[n - 1] * np.cos(omega * t) + b[n - 1] * np.sin(omega * t)
    return result

# === Compute and Reconstruct === #
a0_x, a_x, b_x = compute_fourier_coeffs(x, T)
a0_y, a_y, b_y = compute_fourier_coeffs(y, T)
a0_k, a_k, b_k = compute_fourier_coeffs(kappa, T)

x_recon = reconstruct(a0_x, a_x, b_x, T, t_arr)
y_recon = reconstruct(a0_y, a_y, b_y, T, t_arr)
k_recon = reconstruct(a0_k, a_k, b_k, T, t_arr)

# === Print Coefficients (Grouped Form) === #
print("\n=== Fourier Series Coefficients ===")
print(f"\nx(t)     = a0: {a0_x:.6f}")
print(f"          a_n: {np.round(a_x, 6)}")
print(f"          b_n: {np.round(b_x, 6)}")

print(f"\ny(t)     = a0: {a0_y:.6f}")
print(f"          a_n: {np.round(a_y, 6)}")
print(f"          b_n: {np.round(b_y, 6)}")

print(f"\nkappa(t) = a0: {a0_k:.6f}")
print(f"          a_n: {np.round(a_k, 6)}")
print(f"          b_n: {np.round(b_k, 6)}")

# === Plot Results === #
fig, axs = plt.subplots(3, 1, figsize=(12, 8), sharex=True)

axs[0].plot(t_arr, x, 'r-', label='x original')
axs[0].plot(t_arr, x_recon, 'b--', label='x reconstructed')
axs[0].set_ylabel("x(t)")
axs[0].legend()
axs[0].grid(True)

axs[1].plot(t_arr, y, 'r-', label='y original')
axs[1].plot(t_arr, y_recon, 'b--', label='y reconstructed')
axs[1].set_ylabel("y(t)")
axs[1].legend()
axs[1].grid(True)

axs[2].plot(t_arr, kappa, 'r-', label='kappa original')
axs[2].plot(t_arr, k_recon, 'b--', label='kappa reconstructed')
axs[2].set_ylabel("κ(t)")
axs[2].set_xlabel("time [s]")
axs[2].legend()
axs[2].grid(True)

plt.tight_layout()
plt.suptitle("Fourier Reconstruction of Raceline Variables", fontsize=14, y=1.02)
plt.show()
